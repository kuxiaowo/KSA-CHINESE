<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KsaDir Condition="'$(KsaDir)' == ''">F:\系统应用\Kitten Space Agency</KsaDir>
    <LoaderDir>$(MSBuildThisFileDirectory)..\..\.tools\StarMap-0.4.8</LoaderDir>
    <PluginDir>$(MSBuildThisFileDirectory)..\..\work\build\KsaChinese</PluginDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KsaChinese"><HintPath>$(PluginDir)\KsaChinese.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="KSA"><HintPath>$(KsaDir)\KSA.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Localization"><HintPath>$(KsaDir)\Brutal.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.ImGui"><HintPath>$(KsaDir)\Brutal.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
